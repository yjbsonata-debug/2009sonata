     android:padding="12dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
    <TextView android:text="운전 점수" android:textColor="#9CA3AF" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/score" android:text="100" android:textColor="#4ADE80" android:textSize="38sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="/ 100" android:textColor="#9CA3AF" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
